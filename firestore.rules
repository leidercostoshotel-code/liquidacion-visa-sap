rules_version = '2';
// Esta aplicación no guarda datos en Firestore: se niega toda lectura y escritura,
// para que nadie pueda leer ni escribir la base de datos del proyecto con la clave pública.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
